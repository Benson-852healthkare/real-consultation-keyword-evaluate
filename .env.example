# Google Gemini: appointment notes -> clinical keywords
GEMINI_API_KEY=
KEYWORD_MODEL=gemini-2.5-flash

# Alibaba Cloud Model Studio / DashScope: recordings -> TXT transcripts
DASHSCOPE_API_KEY=
ASR_MODELS=qwen3-asr-flash,qwen-audio-3.0-asr-flash

# Zero-argument workflow paths. Relative paths are resolved from this project.
INPUT_DIR=input
OUTPUT_DIR=results

# Optional: use a fixed keyword JSON/CSV instead of results/generated_keywords.json.
# KEYWORD_CONFIG=results/generated_keywords.json

# Optional endpoint/proxy overrides.
# DASHSCOPE_HTTP_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_NATIVE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# DASHSCOPE_PROXY=http://127.0.0.1:10808
